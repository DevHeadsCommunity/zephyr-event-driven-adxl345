/*
 * NUCLEO-C562RE with the ECW emulated ADXL345 sensor (HIL) on the Arduino header (SPI1).
 *
 * Wiring uses the board's default Arduino SPI pins:
 *   SCK  PA5 (D13)
 *   MOSI PA7 (D11, MCU out)
 *   MISO PA6 (D12, MCU in)
 *   CS   PC9 (D10)
 */
/ {
	aliases {
		accel0 = &ecw_adxl345;
		/* LD1 shares PA5 with the SPI clock, so using it as an LED would break SPI. No LED here. */
		/delete-property/ led0;
	};
};

/*
 * SPI1 is clocked from APB2 and can divide by 256 at most. At the default 72 MHz that
 * still gives 281 kHz, which is too fast here. Dropping APB2 to 36 MHz (144 MHz / 4)
 * brings the slowest SPI clock down to about 140 kHz.
 */
&rcc {
	apb2-prescaler = <4>;
};

&arduino_spi {
	status = "okay";

	ecw_adxl345: adxl345@0 {
		compatible = "ecw,adxl345-burst";
		reg = <0>;
		spi-max-frequency = <140625>;		/* 36 MHz / 256 */
		spi-cs-setup-delay-ns = <2000>;		/* CS low, then 2 us */
		spi-cs-hold-delay-ns = <2000>;		/* 2 us, then CS high */
		sampling-frequency = <100>;
		fifo-watermark = <10>;
	};
};
